{
  "rewrites": [
    { "source": "/api/:a/:b/:c/:d/:e", "destination": "/api/gateway?a=:a&b=:b&c=:c&d=:d&e=:e" },
    { "source": "/api/:a/:b/:c/:d", "destination": "/api/gateway?a=:a&b=:b&c=:c&d=:d" },
    { "source": "/api/:a/:b/:c", "destination": "/api/gateway?a=:a&b=:b&c=:c" },
    { "source": "/api/:a/:b", "destination": "/api/gateway?a=:a&b=:b" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/photos/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
