# Adresse publique du menu, imprimée dans le QR code des tables.
# Exemple : https://chezpapa.be/menu
# Tant que cette valeur est vide, locale ou encore un domaine d'exemple,
# aucun QR code n'est généré.
VITE_PUBLIC_MENU_URL=

# Coordonnées affichées seulement lorsqu'elles sont renseignées.
VITE_RESTAURANT_ADDRESS=
VITE_RESTAURANT_PHONE=
VITE_RESTAURANT_HOURS=
VITE_RESTAURANT_MAPS_URL=
# Lien « Demander des avis » de la fiche Google du restaurant.
# Exemple : https://search.google.com/local/writereview?placeid=ChIJ...
# ou https://g.page/r/XXXX/review
VITE_RESTAURANT_REVIEWS_URL=
VITE_RESTAURANT_INSTAGRAM=
VITE_RESTAURANT_FACEBOOK=

# Code partagé de la salle, pour l'ancien registre local de l'appareil.
# Les clients ne créent pas de compte. Laissez vide tant que le code n'est pas choisi.
VITE_SALLE_CODE=

# Adresse de l'API quand l'application Android n'est pas ouverte sur le même site.
# Exemple : https://chezpapa-beta.vercel.app
VITE_API_BASE=

# Variables serveur uniquement. Ne jamais les préfixer par VITE_.
# Elles se configurent dans Vercel, pas dans le code public.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ORDER_TOKEN_KEY=
STAFF_PASSWORD=
