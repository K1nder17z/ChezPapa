# Adresse publique du menu, imprimée dans le QR code des tables.
# Exemple : https://chezpapa.be/menu
# Tant que cette valeur est vide, locale ou encore un domaine d'exemple,
# aucun QR code n'est généré.
VITE_PUBLIC_MENU_URL=

# Coordonnées affichées seulement lorsqu'elles sont renseignées.
VITE_RESTAURANT_ADDRESS=
VITE_RESTAURANT_PHONE=
VITE_RESTAURANT_HOURS=
VITE_RESTAURANT_MAPS_URL=
VITE_RESTAURANT_REVIEWS_URL=
VITE_RESTAURANT_INSTAGRAM=
VITE_RESTAURANT_FACEBOOK=
